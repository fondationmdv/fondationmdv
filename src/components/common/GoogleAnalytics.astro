---
export interface Props {
  id: string;
  partytown?: boolean;
}

const { id, partytown = false } = Astro.props;
const scriptType = partytown ? 'text/partytown' : undefined;
---

<script is:inline async type={scriptType} src={`https://www.googletagmanager.com/gtag/js?id=${id}`}></script>
<script is:inline define:vars={{ id }} type={scriptType}>
  window.dataLayer = window.dataLayer || [];
  function gtag(...args) {
    window.dataLayer.push(args);
  }
  gtag('js', new Date());
  gtag('config', id);
</script>
