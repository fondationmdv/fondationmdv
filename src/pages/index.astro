---
import Layout from '~/layouts/PageLayout.astro';

import Hero from '~/components/widgets/Hero.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

import Features2 from '~/components/widgets/Features2.astro';
import Features from '~/components/widgets/Features.astro';
import Stats from '~/components/widgets/Stats.astro';
import Content from '~/components/widgets/Content.astro';
import Features3 from '~/components/widgets/Features3.astro';
import FAQs from '~/components/widgets/FAQs.astro';
import Brands from '~/components/widgets/Brands.astro';

import { YouTube } from 'astro-embed';

const metadata = {
  // title: 'Index',
  ignoreTitleTemplate: true,
};

---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        target: '_blank',
        text: 'Contactez-nous!',
        href: 'mailto:fondationmdv@hotmail.com',
        icon: 'tabler:message-circle',
      },
    ]}
  >
    <Fragment slot="title">
      <h1 style="font-size:1.5em; font-weight:bold">Bienvenue sur le site officiel de la Fondation de l'école Madeleine-De-Verchères!</h1><br>
    </Fragment>

    <Fragment slot="subtitle">
    Notre mission est de <u>soutenir les projets éducatifs et communautaires</u> qui enrichissent la vie scolaire des élèves.<br>
    Découvrez nos actions, contribuez à nos projets, ou impliquez-vous dès aujourd’hui!
    </Fragment>

    <!-- <Fragment slot="image">
      <YouTube id="bdGL9HLHbB8" title="La Face Brillante de la Lune - MDV 2019 (Comfortably Numb)" />
      <style is:inline>
        lite-youtube {
          margin: 0 auto;
          max-width: 100%;
        }
      </style>
    </Fragment> -->
  </Hero>

  <!-- Stats Widget ****************** -->

  <Stats
    title="Depuis 2020, la Fondation MDV c'est:"
    stats={[
      { title: 'Montant collecté', amount: '25K' },
      { title: 'Montant investi', amount: '22K' },
      { title: 'Projets proposés', amount: '50' },
      { title: 'Projets acceptés', amount: '40' },
    ]}
  />

  <!-- Content Widget **************** -->

  <Content
    isAfterContent
    items={[
      {
        title: 'Projet 1',
        description: `Tailor the template effortlessly to match your brand's identity and requirements, making your website distinct and saving you time.`,
      },
      {
        title: 'Projet 2',
        description:
          'Explore various layout options to find the structure that best presents your content, enhancing user engagement and navigation.',
      },
      {
        title: 'Projet 3',
        description:
          "Ensure your website's optimal performance on various devices and screen sizes, providing a consistent and enjoyable user experience.",
      },
      {
        title: 'Projet 4',
        description:
          'Seamlessly incorporate images, videos, and multimedia elements that enhance your content and engage visitors effectively.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1600132806370-bf17e65e942f?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2194&q=80',
      alt: 'Blueprint Image',
    }}
  >
    <Fragment slot="content"><u>En 2025 c'est 5000$ récoltés et 12 projets financés!</u><br>Vous pouvez trouver le détail <a href="url">ici</a>, mais voici quelques exemples:</Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

